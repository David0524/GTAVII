{
  "name": "tenderloin-74",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser open-world engine and city: Manhattan's Tenderloin, summer 1974.",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "data": "npm run data:fetch && npm run data:build && npm run data:audit",
    "data:audit": "python3 tools/pipeline/audit_report.py",
    "shots:vehicles": "tsx tools/shots/vehicles.ts",
    "data:build": "tsx tools/pipeline/build.ts",
    "data:fetch": "tsx tools/pipeline/fetch.ts",
    "dev": "vite",
    "preview": "vite preview --port 4173",
    "shots": "tsx tools/shots/capture.ts",
    "audio:test": "tsx tools/audio/render.ts",
    "audio:bake": "tsx tools/audio/bake.ts",
    "audio:stems": "tsx tools/audio/stems.ts",
    "audio:voices": "tsx tools/audio/voices.ts",
    "audio:voices:build": "tsx tools/audio/voices.ts --soft",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:viewport": "vite build && tsx tools/tests/viewport.ts",
    "test:load": "vite build && tsx tools/tests/loadtime.ts",
    "test:windows": "vite build && tsx tools/tests/windows.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@echogarden/espeak-ng-emscripten": "0.3.5",
    "@types/earcut": "3.0.0",
    "@types/node": "26.6.11",
    "@types/three": "0.187.0",
    "clipper-lib": "6.4.2",
    "earcut": "3.2.4",
    "ffmpeg-static": "5.3.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.4.0"
  }
}
